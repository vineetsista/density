# Environments
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Compiled acceleration kernels. Built lazily on first import and cached
# under the user cache directory, never inside the repo.
*.so

# Generated data: synth corpora, stores, reports produced during development.
# Anchored to the repo root so a file of the same name inside the package
# (a template, a fixture) is never silently excluded from the wheel.
/raw/
/raw.density/
/report.html
/report.md
/scratch/
/bench-smoke/
# Deliberately unanchored: a user store built anywhere in a working tree.
# Directory-only, so no shipping file can be caught by it.
*.density/

# Secrets
.env
.env.*

# Editors and OS noise
.idea/
.vscode/
.DS_Store
